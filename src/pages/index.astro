import Solution from "../sections/Solution.astro";
import Benefits from "../sections/Benefits.astro";
import FinalCta from "../sections/FinalCta.astro";
import Footer from "../sections/Footer.astro";
---

<Base
  title="Личная CRM — помни людей, а не только их имена"
  description="Личная CRM для тех, кто любит знакомиться. Кто этот человек, где вы встретились и о чём договорились — всё в одной карточке."
>
  <Header />
  <main>
    <Hero />
    <Problem />
    <Solution />
    <Benefits />
    <FinalCta />
  </main>
  <Footer />
</Base>
