---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  // Width the photo is drawn at after `object-fit: cover`, for the browser to pick a file
  sizes: string;
  // The first-screen photo loads right away, the rest lazily
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes, priority = false, class: className } = Astro.props;
---

<div class:list={["relative overflow-hidden rounded-photo bg-photo", className]}>
  <Picture
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1600, 2000]}
    sizes={sizes}
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    pictureAttributes={{ class: "block size-full" }}
    class="size-full object-cover object-center"
  />
  <slot />
</div>
