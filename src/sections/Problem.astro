---
import Script from "../components/Script.astro";

const pains = [
  "После форума в телефоне двадцать новых номеров, а через неделю уже не вспомнить, кто есть кто.",
  "Человек радостно здоровается, а ты лихорадочно вспоминаешь, где вы виделись.",
  "«Давай созвонимся после праздников» — и оба забыли.",
  "Тебе рассказали о новой работе или переезде, а при следующей встрече ты не можешь об этом спросить — просто не помнишь.",
];
---

<section class="border-t border-dashed border-divider">
  <div
    class="mx-auto flex max-w-mobile flex-col gap-6.5 px-6 pt-14 pb-12 lg:grid lg:max-w-page lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-start lg:gap-20 lg:px-16 lg:py-26 xl:px-30"
  >
    <!-- On mobile this wrapper dissolves so the list can sit between the heading and the note -->
    <div class="contents lg:flex lg:flex-col lg:gap-3.5">
      <p class="font-script text-kicker text-accent lg:text-kicker-lg">знакомо?</p>
      <h2 class="-mt-3.5 text-h2 text-balance lg:mt-0 lg:text-h2-lg">
        Знакомств всё больше — а <Script class="text-h2-script lg:text-h2-script-lg">людей</Script> запоминаешь реже
      </h2>

      <!-- content-box like the mockup: the 440px max width excludes the padding -->
      <div
        class="relative order-last mt-2 box-content -rotate-[1.2deg] bg-sheet px-5 pt-5.5 pb-5 shadow-note lg:mt-9 lg:max-w-110 lg:-rotate-[1.5deg] lg:px-7 lg:pt-7.5 lg:pb-6.5 lg:shadow-note-lg"
      >
        <span
          class="absolute -top-2.5 left-1/2 -ml-10.5 h-5.5 w-21 rotate-2 bg-tape lg:-top-3 lg:-ml-12.5 lg:h-6 lg:w-25"
          aria-hidden="true"></span>
        <p class="text-note-line text-ink-2 lg:text-note-line-lg">Дело не в том, что люди тебе безразличны.</p>
        <p class="mt-1.5 font-script text-note-script text-accent lg:mt-2 lg:text-note-script-lg">
          Просто память не рассчитана на сотни знакомств.
        </p>
      </div>
    </div>

    <ul class="flex flex-col gap-4.5 lg:grid lg:grid-cols-2 lg:gap-x-11 lg:gap-y-10 lg:pt-14">
      {
        pains.map((pain) => (
          <li class="grid grid-cols-[22px_1fr] gap-2.5 text-item text-ink-2 lg:grid-cols-[24px_1fr] lg:gap-3 lg:text-item-lg">
            <span class="text-bullet lg:text-bullet-lg" aria-hidden="true">
              •
            </span>
            <span>{pain}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
